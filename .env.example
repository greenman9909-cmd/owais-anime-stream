# ==============================================================================
# AnimeXOsource_Owais Environment Configuration
# ==============================================================================

# Server Network Binding
PORT=8000
HOST=0.0.0.0

# Stream Resolver Configuration
# Leave RESOLVER_BASE empty during local-first development.
# When empty, /api/stream returns HTTP 503 ("resolver not configured") cleanly.
RESOLVER_BASE=
RESOLVER_KEY=

# Origin Shielding (HMAC-SHA256 URL token signing key)
SHIELD_SECRET=change-me-secret-key-anime-xo

# Studio Console Authentication Gate (Optional)
# If set, accessing the Studio console requires Header: Authorization: Bearer <STUDIO_TOKEN>
STUDIO_TOKEN=

# Edge Cluster Telemetry Hosts (Leave empty for unconfigured status or provide domains)
SORA_HOST=
NEKO_HOST=
ZOZO_HOST=
